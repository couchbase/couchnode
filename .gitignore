# Local test configuration
config.json

# Compiled Object files
*.slo
*.lo
*.o

# Compiled Dynamic libraries
*.so

# Compiled Static libraries
*.lai
*.la
*.a

# The original file after running astyle:
*.orig

# Ignore some IDE-specific folder
/.idea
/.vscode

# User folders
*~

# Build stuff
/.lock-wscript
/build/
/node_modules/
# Vitest writes a cache to node_modules/.vite beside each config it loads,
# including the self-test fixtures under test/, so this rule is unanchored.
node_modules/
/docs/
/builderror.log
/configcache.txt
/coverage/
/benchmarks/
/prebuilds/
/deps/couchbase-cxx-cache
*.tar.gz
/tools/bindings.json
.cache/

# Extra stuff
/dist/
.DS_Store

# AI things
.agents/
.claude/
.ai_discussions/
.opencode/
# Python bytecode from the autogen tooling
__pycache__/
*.py[cod]
