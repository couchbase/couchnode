{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    // The published library targets Node 12; the tests only ever run on the
    // runner's Node, so they may use anything modern (AggregateError, and the
    // bigint literals the subdoc counter suite is about, which need the
    // `target` raised too, not just the `lib`).
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    // The tools under `tools/` run under plain `node`, which resolves ESM
    // specifiers literally, so their own imports name `.ts` files explicitly.
    // Permitted rather than required: everything Vitest loads stays
    // extensionless.
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The couchbase2 generated types import `Long` from @grpc/proto-loader,
    // which takes it with `import Long = require('long')`. Under bundler
    // resolution that finds long's ESM types, whose module object is only a
    // namespace, so every int64 field fails as TS2709. Point long at its
    // CommonJS types, which the library build already resolves.
    "paths": {
      "long": ["../node_modules/long/umd/index.d.ts"]
    }
  },
  "include": ["."]
}
