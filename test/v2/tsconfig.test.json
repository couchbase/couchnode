{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    // The published library targets Node 12; the tests only ever run on the
    // runner's Node, so they may use anything modern (AggregateError, and the
    // bigint literals the subdoc counter suite is about, which need the
    // `target` raised too, not just the `lib`).
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    // The tools under `tools/` run under plain `node`, which resolves ESM
    // specifiers literally, so their own imports name `.ts` files explicitly.
    // Permitted rather than required: everything Vitest loads stays
    // extensionless.
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["."]
}
